<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Estate Properties"
                decoration-success="state == 'offer_received'"
                decoration-muted="state == 'sold'"
                decoration-bf="state == 'offer_accepted'">
                <field name="name"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="best_price" readonly="1"/>
                <field name="state"/>
                <field name="property_type_id"/>
                <field name="buyer_id"/>
                <field name="salesperson_id"/>
                <field name="living_area"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Estate Property">
                <header>
                    <button name="action_sold_property" type="object" string="Sold" class="oe_highlight"
                            invisible="state in ('sold', 'cancelled')"/>
                    <button name="action_cancel_property" type="object" string="Cancel" class="btn-secondary"
                            invisible="state in ('sold', 'cancelled')"/>

                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                        </group>
                        <group>
                            <field name="state" widget="statusbar" readonly="1"/>
                            <field name="postcode"/>
                        </group>
                         <group>
                        <field name="name"/>
                        <field name="property_type_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="buyer_id"/>
                        <field name="salesperson_id"/>
                        </group>
                        <group string="Garden Details">
                            <field name="garden"/>
                            <field name="garden_area" invisible="not garden"/>
                            <field name="garden_orientation" invisible="not garden"/>

                        </group>
                        <group>
                            <field name="living_area"/>  
                            <field name="garden_area"/>
                            <field name="total_area" readonly="1"/>  
                        </group>
                        <group>
                        <field name="name"/>
                        <field name="best_price" readonly="1"/>
                        <field name="offer_ids" widget="one2many" readonly="state in ('offer_accepted', 'sold', 'cancelled')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name"/>
                <field name="state"/>
                <field name="postcode"/>
                
                <filter string="Available" name="filter_available" 
                    domain="[('state', 'in', ['new', 'offer_received'])]"/>
                <group string="Group By">
                    <filter string="Postcode" name="group_by_postcode" 
                        context="{'group_by': 'postcode'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
