<odoo>
    <!-- List View -->
    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Property Offers" editable="bottom"
                decoration-danger="status == 'refused'"
                decoration-success="status == 'accepted'">
                <field name="price"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="status"/>
                <field name="partner_id"/>
                <field name="property_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="estate_property_offer_form_view" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offer">
                <header>
                    <button name="action_accept_offer" type="object" string="Accept" class="oe_highlight"/>
                    <button name="action_refuse_offer" type="object" string="Refuse" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="price"/>
                        <field name="status"/>
                    </group>
                    <group>
                            <field name="validity"/>  
                            <field name="date_deadline"/>  
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>
</odoo>
